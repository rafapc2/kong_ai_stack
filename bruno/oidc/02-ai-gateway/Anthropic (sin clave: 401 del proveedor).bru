meta {
  name: Anthropic (sin clave: 401 del proveedor)
  type: http
  seq: 4
}

post {
  url: {{gateway}}/oidc/ai/anthropic/chat
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token_user}}
  Content-Type: application/json
}

body:json {
  {"messages":[{"role":"user","content":"Responde solo: ok"}]}
}

assert {
  res.status: in [200, 401]
}
