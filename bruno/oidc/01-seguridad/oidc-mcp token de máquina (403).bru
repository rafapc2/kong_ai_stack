meta {
  name: oidc-mcp token de máquina (403)
  type: http
  seq: 7
}

post {
  url: {{gateway}}/oidc/mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token_alice}}
  Content-Type: application/json
}

body:json {
  {"jsonrpc":"2.0","id":1,"method":"ping"}
}

assert {
  res.status: eq 403
}
