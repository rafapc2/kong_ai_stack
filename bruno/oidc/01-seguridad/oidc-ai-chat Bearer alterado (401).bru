meta {
  name: oidc-ai-chat Bearer alterado (401)
  type: http
  seq: 4
}

post {
  url: {{gateway}}/oidc/ai/chat
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token_user}}x
  Content-Type: application/json
}

body:json {
  {"messages":[{"role":"user","content":"hola"}]}
}

assert {
  res.status: eq 401
}
