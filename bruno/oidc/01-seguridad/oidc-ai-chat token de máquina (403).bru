meta {
  name: oidc-ai-chat token de máquina (403)
  type: http
  seq: 3
}

post {
  url: {{gateway}}/oidc/ai/chat
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token_alice}}
  Content-Type: application/json
}

body:json {
  {"messages":[{"role":"user","content":"hola"}]}
}

assert {
  res.status: eq 403
}
