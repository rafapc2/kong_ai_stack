meta {
  name: oidc-a2a Bearer alterado (401)
  type: http
  seq: 12
}

post {
  url: {{gateway}}/oidc/a2a/
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token_user}}x
  Content-Type: application/json
}

body:json {
  {"jsonrpc":"2.0","id":1,"method":"ping"}
}

assert {
  res.status: eq 401
}
