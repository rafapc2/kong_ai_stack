meta {
  name: oidc-mcp sin credenciales (401)
  type: http
  seq: 5
}

post {
  url: {{gateway}}/oidc/mcp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"jsonrpc":"2.0","id":1,"method":"ping"}
}

assert {
  res.status: eq 401
  res.headers["www-authenticate"]: contains resource_metadata
}
