meta {
  name: message-send
  type: http
  seq: 2
}

post {
  url: {{gateway}}/oidc/a2a/
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token_user}}
  Content-Type: application/json
}

body:json {
  {"jsonrpc":"2.0","id":1,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"m1","parts":[{"kind":"text","text":"mi factura"}]}}}
}

assert {
  res.status: eq 200
}
