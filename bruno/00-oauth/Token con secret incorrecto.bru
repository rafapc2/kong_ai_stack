meta {
  name: Token con secret incorrecto
  type: http
  seq: 3
}

post {
  url: {{keycloak}}/realms/kong-demo/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{alice_client_id}}
  client_secret: mal
}

assert {
  res.status: eq 401
}
