meta {
  name: Bearer con firma alterada (401)
  type: http
  seq: 7
}

post {
  url: {{gateway}}/mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token_alice}}x
  Content-Type: application/json
}

body:json {
  {"jsonrpc":"2.0","id":1,"method":"ping"}
}

assert {
  res.status: eq 401
}
