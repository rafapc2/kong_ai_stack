meta {
  name: Chat mock (system prompt inyectado)
  type: http
  seq: 1
}

post {
  url: {{gateway}}/ai/chat
  body: json
  auth: none
}

headers {
  apikey: {{apikey_alice}}
  Content-Type: application/json
}

body:json {
  {"messages":[{"role":"user","content":"Hola"}]}
}

assert {
  res.status: eq 200
  res.body.choices[0].message.content: isString
}
