meta {
  name: Token de máquina client_credentials (403)
  type: http
  seq: 4
}

post {
  url: {{gateway}}/mcp-oidc
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token_alice}}
  Content-Type: application/json
}

body:json {
  {"jsonrpc":"2.0","id":1,"method":"ping"}
}

assert {
  res.status: eq 403
}
