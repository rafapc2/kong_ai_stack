meta {
  name: initialize
  type: http
  seq: 1
}

post {
  url: {{gateway}}/mcp
  body: json
  auth: none
}

headers {
  apikey: {{apikey_alice}}
  Content-Type: application/json
}

body:json {
  {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"bruno","version":"1"}}}
}

assert {
  res.status: eq 200
  res.body.result.serverInfo.name: eq demo-mcp
}
