# Copia este archivo a .env y rellena las claves de los proveedores que quieras usar.
# Sin claves, el stack funciona igualmente con el LLM falso en /ai/chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Login social para /mcp-oidc (Keycloak actúa de broker). Redirect URI a registrar en cada proveedor:
#   http://localhost:8180/realms/kong-demo/broker/<google|github|linkedin>/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
